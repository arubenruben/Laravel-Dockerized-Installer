; PHP overrides for the app image (copied to conf.d/zz-app.ini, so it loads
; after, and wins over, the base image's ini files).
; Generated by Laravel Dockerized Installer

; Largest single uploaded file. PHP's default is 2M, and PHP rejects anything
; bigger before Laravel's validation runs. A rule like `max:4096` would then
; show the generic "failed to upload" error instead of the app's own message.
upload_max_filesize = {{ max_upload_mb }}M

; Largest request body, which must hold the file plus the other form fields
; and multipart overhead (hence upload_max_filesize + 2M). Keep it equal to
; `client_max_body_size` in docker/nginx.conf: if nginx's limit is lower it
; answers 413 first, and if it is higher PHP silently drops the whole POST.
post_max_size = {{ post_max_mb }}M

; PHP's default (128M) is tight for image processing and large Inertia payloads.
memory_limit = 256M
