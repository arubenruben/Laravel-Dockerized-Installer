#!/bin/sh
# Laravel + Inertia.js — Docker entrypoint (stage/prod)
# Generated by Laravel Dockerized Installer
#
# Starts as root, prepares storage (below), then:
#
#   sh docker/prod.entrypoint.sh
#       Web mode (the image's CMD): migrates the database as www-data, then
#       starts php-fpm and nginx.
#
#   sh docker/prod.entrypoint.sh <command…>
#       Worker mode, e.g. `sh docker/prod.entrypoint.sh php artisan queue:work`:
#       runs <command> as www-data instead of starting php-fpm + nginx. The
#       worker service reuses the app image but skips migrations: the compose
#       files make it wait for a healthy `app`, which only happens once they
#       have run. `exec` keeps the command as PID 1, so `docker stop`'s SIGTERM
#       reaches it and queue:work (or Horizon) can finish its current job
#       before exiting.
#
# Everything the application writes runs as www-data, never root: a root-owned
# file in storage/ (logs, cache) or the SQLite directory can no longer be
# written by php-fpm's www-data workers.
set -e

# ── 1. Prepare storage ───────────────────────────────────────────────────────
# Runs on every boot, in both modes. storage/app is a named volume (see the
# compose file) that hides the image's copy, so Laravel's directories have to
# be recreated, and what the previous run or a root-run command left behind
# has to be handed back to www-data.
mkdir -p storage/app/private storage/app/public storage/logs \
    storage/framework/cache/data storage/framework/sessions storage/framework/views \
    bootstrap/cache

# public/storage → storage/app/public, so files on the `public` disk are served.
# It lives in the container's writable layer, so it is gone after a recreate.
[ -L public/storage ] || php artisan storage:link --no-interaction

{% if db == 'sqlite' %}
# The SQLite file lives on its own volume so every container sees the same
# database and it survives a recreate. SQLite writes its journal next to the
# database, so www-data needs the directory as well as the file.
DB_FILE="${DB_DATABASE:-database/database.sqlite}"
DB_DIR="$(dirname "$DB_FILE")"
mkdir -p "$DB_DIR"
touch "$DB_FILE"
chown www-data:www-data "$DB_DIR" "$DB_FILE"

{% endif %}
# Only files that are not already www-data's are touched, so this stays cheap
# on a large uploads volume.
find storage bootstrap/cache ! -user www-data -exec chown www-data:www-data {} +

# ── 2. Worker mode ───────────────────────────────────────────────────────────
if [ "$#" -gt 0 ]; then
    exec su-exec www-data "$@"
fi

{% if db == 'sqlite' %}
# ── 3. Run migrations ─────────────────────────────────────────────────────────
echo "==> Running database migrations..."
su-exec www-data php artisan migrate --force --no-interaction

{% else %}
# ── 3. Wait for the database, then migrate ────────────────────────────────────
echo "==> Waiting for the database to be ready..."
MAX_RETRIES=30
ATTEMPT=0
until su-exec www-data php artisan migrate --force --no-interaction; do
    ATTEMPT=$((ATTEMPT + 1))
    if [ "$ATTEMPT" -ge "$MAX_RETRIES" ]; then
        echo "ERROR: Database not reachable after ${MAX_RETRIES} attempts. Exiting."
        exit 1
    fi
    echo "    Not ready yet, retrying in 3 s... (${ATTEMPT}/${MAX_RETRIES})"
    sleep 3
done

{% endif %}
echo "==> Starting php-fpm and nginx..."
php-fpm -D
exec nginx -g "daemon off;"
