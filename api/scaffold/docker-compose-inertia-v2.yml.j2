# Laravel + Inertia.js ({{ starter_kit | replace('-', ' ') | title }}) — Docker Compose stack
x-app-environment: &app-environment
  APP_ENV: local
{% if db == 'mysql' %}
  DB_CONNECTION: mysql
  DB_HOST: db
  DB_PORT: 3306
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: secret
{% elif db == 'postgres' %}
  DB_CONNECTION: pgsql
  DB_HOST: db
  DB_PORT: 5432
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: secret
{% else %}
  DB_CONNECTION: sqlite
  DB_DATABASE: /var/www/html/database/database.sqlite
{% endif %}
  QUEUE_CONNECTION: {{ queue }}
{% if queue == 'redis' %}
  REDIS_CLIENT: predis
  REDIS_HOST: redis
  REDIS_PORT: 6379
{% endif %}
  VITE_DEV_SERVER_HOST: 0.0.0.0

services:
  app:
    build: .
{% if queue != 'sync' %}
    # Explicit tag so `worker` can reuse this image instead of building it again.
{% endif %}
    image: {{ app_slug }}-app:dev
    container_name: {{ app_slug }}_app
    restart: unless-stopped
    working_dir: /var/www/html
    command: ["sh", "docker/dev.entrypoint.sh"]
    ports:
      - "{{ app_port }}:8000"
    volumes:
      - .:/var/www/html
{% if db != 'sqlite' or queue == 'redis' %}
    depends_on:
{% if db != 'sqlite' %}
      db:
        condition: service_started
{% endif %}
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
{% endif %}
    environment: *app-environment
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{% if queue != 'sync' %}
  # Runs queued jobs with a real queue, matching stage/production (docker-compose.*.yml),
  # so jobs behave the same locally as once deployed: rate limiting, retries and
  # timeouts only apply when jobs go through a queue instead of running inline
  # in the web request (QUEUE_CONNECTION=sync). `queue:listen` reloads the code
  # for every job, so edits are picked up without restarting the worker.
  worker:
    image: {{ app_slug }}-app:dev
    # Built by `app` above; never try to pull it from a registry.
    pull_policy: never
    container_name: {{ app_slug }}_worker
    restart: unless-stopped
    working_dir: /var/www/html
    command: >
      sh -c "echo 'Waiting for composer dependencies...' &&
             until [ -f vendor/autoload.php ]; do sleep 2; done &&
             exec php artisan queue:listen --tries=1 --timeout=0"
    volumes:
      - .:/var/www/html
    depends_on:
      app:
        condition: service_started
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
    environment: *app-environment
{% endif %}

  vite:
    image: php:{{ php_version }}-cli-alpine
    container_name: {{ app_slug }}_vite
    restart: unless-stopped
    working_dir: /var/www/html
    command: >
      sh -c "apk add --no-cache nodejs npm &&
             echo 'Waiting for composer dependencies...' &&
             until [ -f vendor/autoload.php ]; do sleep 2; done &&
             npm install &&
             npm run dev -- --host"
    ports:
      - "5173:5173"
    volumes:
      - .:/var/www/html      
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:5173/@vite/client || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

{% if db == 'mysql' %}
  db:
    image: mysql:8.0
    container_name: {{ app_slug }}_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: secret
      MYSQL_ROOT_PASSWORD: rootsecret
    ports:
      - "3306:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "laravel", "-psecret"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
{% elif db == 'postgres' %}
  db:
    image: postgres:16-alpine
    container_name: {{ app_slug }}_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: laravel
      POSTGRES_USER: laravel
      POSTGRES_PASSWORD: secret
    ports:
      - "5432:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "laravel", "-d", "laravel"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
{% endif %}
{% if queue == 'redis' %}
  redis:
    image: redis:7-alpine
    container_name: {{ app_slug }}_redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
{% endif %}

volumes:
  vite_node_modules:
{% if db != 'sqlite' %}
  db_data:
{% endif %}
