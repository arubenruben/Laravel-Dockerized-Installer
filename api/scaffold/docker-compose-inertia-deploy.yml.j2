# Laravel + Inertia.js ({{ starter_kit | replace('-', ' ') | title }}) — {{ deploy_env }} stack
# Runs the image built by `docker build .` (php-fpm + nginx, assets pre-built).
# No source bind mount, no Vite sidecar. The image contains no .env (.dockerignore
# excludes it), so every runtime setting comes from the x-app-environment block
# below, which `app`{% if queue != 'sync' %} and `worker` share{% else %} uses{% endif %}.
#
# Deploying — either build the image on this host:
#   docker compose -f docker-compose.{{ env_suffix }}.yml up -d --build
# or use an image pushed by CI (APP_IMAGE is the repository, IMAGE_TAG the tag):
#   export APP_IMAGE=<registry>/<image> IMAGE_TAG=<tag>
#   docker compose -f docker-compose.{{ env_suffix }}.yml pull
#   docker compose -f docker-compose.{{ env_suffix }}.yml up -d --no-build
# Without them the image is `{{ app_slug }}:latest`. Keep both set (exported, or in the env
# file) for every `docker compose` call that starts containers: with only `pull`
# given them, `up` would look for `{{ app_slug }}:latest` instead of the pulled image.
#
# This stack is its own Compose project, `{{ app_slug }}-{{ env_suffix }}`. The other environment's file
# declares a different project name, so the two stacks run side by side from the
# same checkout without sharing containers or volumes.{% if proxy_network %}
#
# `app` publishes no host port: it joins the external Docker network `{{ proxy_network }}` under
# the alias `{{ app_slug }}-{{ env_suffix }}`, and the reverse proxy attached to that network routes the
# domain to http://{{ app_slug }}-{{ env_suffix }}:80. Create the network once, before the first `up`:
#   docker network create {{ proxy_network }}
# Only `app` joins it; every other service stays on this stack's own network. Staging
# and production can join the same network at once, since their aliases differ.{% else %} They do share the host port
# unless you set APP_PORT (default {{ '8001' if env_suffix == 'stage' else '8000' }} here).{% endif %}
#
# Where the ${VAR} placeholders come from: the shell environment, or an env file —
# the one given with `--env-file <path>`, otherwise a file named exactly `.env` next
# to this file. A differently named file (e.g. `.env.docker`) is silently ignored
# unless you pass it with --env-file. Shell variables win over the env file.
# The project's generated .env is read this way too, so its dev values (a localhost
# APP_URL{% if db != 'sqlite' %}, DB_PASSWORD=secret{% endif %}) apply until you override them.
#
# `docker compose` refuses to start without these: APP_KEY, APP_URL{% if db != 'sqlite' %}, DB_PASSWORD{% endif %}{% if db == 'mysql' %}, DB_ROOT_PASSWORD{% endif %}{% if queue == 'redis' %}, REDIS_PASSWORD{% endif %}.
# Everything else has a default, e.g. mail goes to the log (MAIL_MAILER=log) until
# you configure MAIL_*.
#
# Check what Compose resolves before deploying:
#   docker compose -f docker-compose.{{ env_suffix }}.yml config
#   docker compose --env-file <path> -f docker-compose.{{ env_suffix }}.yml config
{% if queue != 'sync' %}
# `worker` reuses the app image and processes queued jobs{% if horizon %} through Laravel Horizon{% endif %}; on stop it gets
# WORKER_STOP_GRACE_PERIOD (default 90s) to finish its job — keep it above the
# {% if horizon %}longest job timeout (60s by default in config/horizon.php){% else %}60s default job timeout{% endif %}, or deploys will kill jobs mid-run.
{% endif -%}
#
{% set limit_prefixes = ['APP_'] + (['WORKER_'] if queue != 'sync' else []) + (['DB_'] if db != 'sqlite' else []) + (['REDIS_'] if queue == 'redis' else []) -%}
# Every service has CPU and memory limits and reservations (`deploy.resources`), so a
# runaway process or a memory leak can't starve the database and everything else on the
# host. Each value is overridable per service with <PREFIX>CPU_LIMIT, <PREFIX>MEM_LIMIT,
# <PREFIX>CPU_RESERVATION and <PREFIX>MEM_RESERVATION, where <PREFIX> is the service's
# prefix ({{ limit_prefixes | join(', ') }}); the defaults are on each service. Docker refuses a
# reservation above its limit, so lower the two together. Hosts that cannot apply cgroup
# limits (some Docker-in-Docker setups fail with "cannot enter cgroupv2 ... in threaded
# mode") can drop them with an override file; the README shows one.
name: {{ app_slug }}-{{ env_suffix }}

{% set app_name_default = '${APP_NAME:-' ~ (app_name | compose_default) ~ '}' %}
x-app-image: &app-image
  image: ${APP_IMAGE:-{{ app_slug }}}:${IMAGE_TAG:-latest}

x-app-environment: &app-environment
  APP_NAME: {{ app_name_default | yaml_quote }}
  APP_ENV: {{ deploy_env }}
  APP_DEBUG: "false"
  APP_KEY: ${APP_KEY:?APP_KEY must be set}
  # Base URL for links built outside a request (queued mail, CLI). An https:// URL
  # also makes the app force https:// for every URL it generates.
  APP_URL: ${APP_URL:?APP_URL must be set, e.g. https://app.example.com}
  # The image has no .env, so without these config/app.php would fall back to `en`.
  # `{{ locale }}` is the locale the project was generated with; set either variable at deploy time to change it.
  APP_LOCALE: ${APP_LOCALE:-{{ locale }}}
  APP_FALLBACK_LOCALE: ${APP_FALLBACK_LOCALE:-{{ locale }}}
{% if db == 'mysql' %}
  DB_CONNECTION: mysql
  DB_HOST: db
  DB_PORT: 3306
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
{% elif db == 'postgres' %}
  DB_CONNECTION: pgsql
  DB_HOST: db
  DB_PORT: 5432
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
{% else %}
  DB_CONNECTION: sqlite
  DB_DATABASE: /var/www/html/database/data/database.sqlite
{% endif %}
  QUEUE_CONNECTION: {{ queue }}
{% if queue == 'redis' %}
  REDIS_CLIENT: predis
  REDIS_HOST: redis
  REDIS_PORT: 6379
  REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}
{% endif %}
  MAIL_MAILER: ${MAIL_MAILER:-log}
  MAIL_SCHEME: ${MAIL_SCHEME:-null}
  MAIL_HOST: ${MAIL_HOST:-127.0.0.1}
  MAIL_PORT: ${MAIL_PORT:-2525}
  MAIL_USERNAME: ${MAIL_USERNAME:-null}
  MAIL_PASSWORD: ${MAIL_PASSWORD:-null}
  MAIL_FROM_ADDRESS: ${MAIL_FROM_ADDRESS:-hello@example.com}
  MAIL_FROM_NAME: {{ ('${MAIL_FROM_NAME:-' ~ app_name_default ~ '}') | yaml_quote }}

services:
  app:
{% if queue != 'sync' %}
    # The only service that builds; `worker` reuses the image this one built or pulled.
{% endif %}
    <<: *app-image
    build: .
    container_name: {{ app_slug }}_app_{{ env_suffix }}
    restart: unless-stopped
{%- if proxy_network %}
    # No published port: the reverse proxy on the `{{ proxy_network }}` network reaches this
    # container at http://{{ app_slug }}-{{ env_suffix }}:80, the alias below. Not at `app`: Compose registers
    # the service name on the shared network too, so there it matches every project's `app`.
    # Listing `networks` replaces the implicit default network, so `default` is joined
    # explicitly (the database, Redis and the worker are reached through it).
    networks:
      default:
      proxy:
        aliases:
          - {{ app_slug }}-{{ env_suffix }}
{%- else %}
    ports:
      - "${APP_PORT:-{{ '8001' if env_suffix == 'stage' else '8000' }}}:80"
{%- endif %}
{% if db != 'sqlite' or queue == 'redis' %}
    depends_on:
{% if db != 'sqlite' %}
      db:
        condition: service_started
{% endif %}
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
{% endif %}
    environment:
      <<: *app-environment
    volumes:
      - storage_data:/var/www/html/storage/app
{% if db == 'sqlite' %}
      - sqlite_data:/var/www/html/database/data
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: "${APP_CPU_LIMIT:-1.0}"
          memory: ${APP_MEM_LIMIT:-512M}
        reservations:
          cpus: "${APP_CPU_RESERVATION:-0.25}"
          memory: ${APP_MEM_RESERVATION:-256M}

{% if queue != 'sync' %}
  worker:
    <<: *app-image
    # Built or pulled by `app` above; never build it or pull it separately. Pulling
    # it too would race `app`, and a second build of the same image can crash BuildKit.
    pull_policy: never
    container_name: {{ app_slug }}_worker_{{ env_suffix }}
    restart: unless-stopped
    # Arguments to the entrypoint select its worker mode: it prepares storage like
    # `app` does, then runs the command as www-data, not root.
    command:
      - sh
      - docker/prod.entrypoint.sh
      - php
      - artisan
{% if horizon %}
      - horizon
{% if deploy_env != 'production' %}
      # config/horizon.php only defines `production` and `local` supervisors, and
      # this stack runs with APP_ENV={{ deploy_env }}: without this Horizon would start
      # successfully but run no workers at all.
      - --environment=production
{% endif %}
{% else %}
      - queue:work
      - --sleep=3
      - --tries=3
      - --max-time=3600
{% endif %}
    stop_grace_period: ${WORKER_STOP_GRACE_PERIOD:-90s}
    depends_on:
      # A healthy app means migrations have run.
      app:
        condition: service_healthy
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
    environment:
      <<: *app-environment
    volumes:
      - storage_data:/var/www/html/storage/app
{% if db == 'sqlite' %}
      - sqlite_data:/var/www/html/database/data
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "${WORKER_CPU_LIMIT:-1.0}"
          memory: ${WORKER_MEM_LIMIT:-512M}
        reservations:
          cpus: "${WORKER_CPU_RESERVATION:-0.25}"
          memory: ${WORKER_MEM_RESERVATION:-256M}
{% endif %}

{% if db == 'mysql' %}
  db:
    image: mysql:8.0
    container_name: {{ app_slug }}_db_{{ env_suffix }}
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:?DB_ROOT_PASSWORD must be set}
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u laravel -p\"$$MYSQL_PASSWORD\""]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    # MySQL 8 can exceed 512M while starting, so its defaults are higher than Postgres's.
    deploy:
      resources:
        limits:
          cpus: "${DB_CPU_LIMIT:-1.0}"
          memory: ${DB_MEM_LIMIT:-1G}
        reservations:
          cpus: "${DB_CPU_RESERVATION:-0.25}"
          memory: ${DB_MEM_RESERVATION:-512M}
{% elif db == 'postgres' %}
  db:
    image: postgres:16-alpine
    container_name: {{ app_slug }}_db_{{ env_suffix }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: laravel
      POSTGRES_USER: laravel
      POSTGRES_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "laravel", "-d", "laravel"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: "${DB_CPU_LIMIT:-1.0}"
          memory: ${DB_MEM_LIMIT:-512M}
        reservations:
          cpus: "${DB_CPU_RESERVATION:-0.25}"
          memory: ${DB_MEM_RESERVATION:-256M}
{% endif %}

{% if queue == 'redis' %}
  redis:
    image: redis:7-alpine
    container_name: {{ app_slug }}_redis_{{ env_suffix }}
    restart: unless-stopped
    command: ["sh", "-c", "redis-server --requirepass \"$$REDIS_PASSWORD\" --save 60 1 --appendonly yes"]
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" --no-auth-warning ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: "${REDIS_CPU_LIMIT:-0.5}"
          memory: ${REDIS_MEM_LIMIT:-256M}
        reservations:
          cpus: "${REDIS_CPU_RESERVATION:-0.1}"
          memory: ${REDIS_MEM_RESERVATION:-128M}
{% endif %}

# Compose prefixes volume names with the project name (`{{ app_slug }}-{{ env_suffix }}_storage_data`, …),
# so the two stacks never share one.
volumes:
  # Uploads and other files under storage/app. Survives `down` / `up` (but not `down -v`).
{% if queue != 'sync' %}
  # Shared by `app` and `worker`: files written by web requests are read by queued jobs.
{% endif %}
  storage_data:
{% if db == 'sqlite' %}
  # The SQLite file. A subdirectory of database/, so it doesn't hide database/migrations.
{% if queue != 'sync' %}
  # Shared by `app` and `worker`: with one file per container, the worker would see an
  # empty database.
{% endif %}
  sqlite_data:
{% else %}
  db_data:
{% endif %}
{% if queue == 'redis' %}
  redis_data:
{% endif %}
{%- if proxy_network %}

# `proxy` is this file's name for the network the reverse proxy is attached to. It
# already exists (`docker network create {{ proxy_network }}`) and is not owned by this
# project, so `down` leaves it alone and the name is not prefixed with the project name.
networks:
  default:
  proxy:
    name: {{ proxy_network | yaml_quote }}
    external: true
{%- endif %}
