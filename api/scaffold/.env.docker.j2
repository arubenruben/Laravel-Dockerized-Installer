{#- The settings Docker changes, as KEY=value lines. The Inertia flows merge them into the
    starter kit's .env (see _merge_env); /v1/release writes the file as it is. No blank
    lines or comments, so both give the same file. -#}
APP_NAME={{ app_name | dotenv_quote }}
APP_ENV=local
APP_KEY={{ app_key | default('') }}
APP_DEBUG=true
APP_URL=http://localhost:{{ app_port }}
{#- Only /v2 passes `locale`; every other flow leaves Laravel's own `en` default alone. #}
{%- if locale is defined %}
APP_LOCALE={{ locale }}
APP_FALLBACK_LOCALE={{ locale }}
{%- endif %}
{%- if db == 'mysql' %}
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
{%- elif db == 'postgres' %}
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
{%- else %}
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
{%- endif %}
{#- Only /v2 passes `queue` (and ships a worker); every other flow keeps sync. #}
QUEUE_CONNECTION={{ queue | default('sync') }}
{%- if queue | default('sync') == 'redis' %}
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
{%- endif %}
{#- Only /v1/release sets `legacy_env_keys`: it can target Laravel versions that read these
    instead of CACHE_STORE / BROADCAST_CONNECTION, and has no starter-kit .env to supply
    the rest. The Inertia projects (Laravel 11+) keep the kit's own values. #}
{%- if legacy_env_keys | default(false) %}
LOG_CHANNEL=stack
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120
{%- endif %}
