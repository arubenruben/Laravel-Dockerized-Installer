# Laravel + Inertia.js ({{ starter_kit | replace('-', ' ') | title }}) — staging stack
# Runs the image built by `docker build .` (php-fpm + nginx, assets pre-built).
# No source bind mount, no Vite sidecar — set secrets via shell-exported env vars.
{% if queue == 'redis' %}
# `docker compose` refuses to start without REDIS_PASSWORD (the Redis password).
{% endif %}
{% if queue != 'sync' %}
# `worker` reuses the app image and processes queued jobs{% if horizon %} through Laravel Horizon{% endif %}; on stop it gets
# WORKER_STOP_GRACE_PERIOD (default 90s) to finish its job — keep it above the
# {% if horizon %}longest job timeout (60s by default in config/horizon.php){% else %}60s default job timeout{% endif %}, or deploys will kill jobs mid-run.
{% endif %}
x-app-environment: &app-environment
  APP_ENV: staging
  APP_DEBUG: "false"
  APP_KEY: ${APP_KEY}
{% if db == 'mysql' %}
  DB_CONNECTION: mysql
  DB_HOST: db
  DB_PORT: 3306
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: ${DB_PASSWORD}
{% elif db == 'postgres' %}
  DB_CONNECTION: pgsql
  DB_HOST: db
  DB_PORT: 5432
  DB_DATABASE: laravel
  DB_USERNAME: laravel
  DB_PASSWORD: ${DB_PASSWORD}
{% else %}
  DB_CONNECTION: sqlite
  DB_DATABASE: /var/www/html/database/database.sqlite
{% endif %}
  QUEUE_CONNECTION: {{ queue }}
{% if queue == 'redis' %}
  REDIS_CLIENT: predis
  REDIS_HOST: redis
  REDIS_PORT: 6379
  REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}
{% endif %}

services:
  app:
    build: .
{% if queue != 'sync' %}
    # Explicit tag so `worker` can reuse this image instead of building it again.
{% endif %}
    image: {{ app_slug }}-app:stage
    container_name: {{ app_slug }}_app_stage
    restart: unless-stopped
    ports:
      - "${APP_PORT:-8000}:80"
{% if db != 'sqlite' or queue == 'redis' %}
    depends_on:
{% if db != 'sqlite' %}
      db:
        condition: service_started
{% endif %}
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
{% endif %}
    environment: *app-environment
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{% if queue != 'sync' %}
  worker:
    image: {{ app_slug }}-app:stage
    # Built by `app` above; never try to pull it from a registry.
    pull_policy: never
    container_name: {{ app_slug }}_worker_stage
    restart: unless-stopped
    # The entrypoint's worker mode runs the command as www-data, not root.
    command:
      - sh
      - docker/prod.entrypoint.sh
      - worker
      - php
      - artisan
{% if horizon %}
      - horizon
      # config/horizon.php only defines `production` and `local` supervisors, and
      # this stack runs with APP_ENV=staging: without this Horizon would start
      # successfully but run no workers at all.
      - --environment=production
{% else %}
      - queue:work
      - --sleep=3
      - --tries=3
      - --max-time=3600
{% endif %}
    stop_grace_period: ${WORKER_STOP_GRACE_PERIOD:-90s}
    depends_on:
      # A healthy app means migrations have run.
      app:
        condition: service_healthy
{% if queue == 'redis' %}
      redis:
        condition: service_healthy
{% endif %}
    environment: *app-environment
{% endif %}

{% if db == 'mysql' %}
  db:
    image: mysql:8.0
    container_name: {{ app_slug }}_db_stage
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
    volumes:
      - db_data_stage:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "laravel", "-p${DB_PASSWORD}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
{% elif db == 'postgres' %}
  db:
    image: postgres:16-alpine
    container_name: {{ app_slug }}_db_stage
    restart: unless-stopped
    environment:
      POSTGRES_DB: laravel
      POSTGRES_USER: laravel
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - db_data_stage:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "laravel", "-d", "laravel"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
{% endif %}

{% if queue == 'redis' %}
  redis:
    image: redis:7-alpine
    container_name: {{ app_slug }}_redis_stage
    restart: unless-stopped
    command: ["sh", "-c", "redis-server --requirepass \"$$REDIS_PASSWORD\" --save 60 1 --appendonly yes"]
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}
    volumes:
      - redis_data_stage:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" --no-auth-warning ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
{% endif %}

{% if db != 'sqlite' or queue == 'redis' %}
volumes:
{% if db != 'sqlite' %}
  db_data_stage:
{% endif %}
{% if queue == 'redis' %}
  redis_data_stage:
{% endif %}
{% endif %}
