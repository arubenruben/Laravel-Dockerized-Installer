# Builds the production Dockerfile with Docker-in-Docker and pushes the image to this
# project's GitLab Container Registry ($CI_REGISTRY_IMAGE, i.e. <registry>/<group>/<project>).
# The runner must allow privileged containers, which the docker:27-dind service needs.
#
# Every branch and tag pipeline publishes the image. Tags:
#   <short sha>             every pipeline
#   latest                  the default branch
#   <branch slug>           every other branch
#   <tag name>, stable      git tags
#
# Deploy a pushed tag with the staging/production stacks (use docker-compose.stage.yml
# for staging). Keep both variables set for every command that starts containers:
#   APP_IMAGE=<registry>/<group>/<project> IMAGE_TAG=<tag> docker compose -f docker-compose.prod.yml pull
#   APP_IMAGE=<registry>/<group>/<project> IMAGE_TAG=<tag> docker compose -f docker-compose.prod.yml up -d --no-build
# The host needs `docker login <registry>` (a deploy token with read_registry) if the
# project is private.
stages:
  - build

.docker_build:
  stage: build
  image: docker:27-cli
  services:
    - docker:27-dind
  variables:
    DOCKER_HOST: tcp://docker:2376
    DOCKER_TLS_CERTDIR: "/certs"
    DOCKER_TLS_VERIFY: "1"
    DOCKER_CERT_PATH: "/certs/client"
    IMAGE_NAME: $CI_REGISTRY_IMAGE
  before_script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"

build:default-branch:
  extends: .docker_build
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
  script:
    - docker build -f Dockerfile -t "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA" -t "$IMAGE_NAME:latest" .
    - docker push "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA"
    - docker push "$IMAGE_NAME:latest"

build:branch:
  extends: .docker_build
  rules:
    - if: '$CI_COMMIT_BRANCH && $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH'
  script:
    - docker build -f Dockerfile -t "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA" -t "$IMAGE_NAME:$CI_COMMIT_REF_SLUG" .
    - docker push "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA"
    - docker push "$IMAGE_NAME:$CI_COMMIT_REF_SLUG"

build:tag:
  extends: .docker_build
  rules:
    - if: '$CI_COMMIT_TAG'
  script:
    - docker build -f Dockerfile -t "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA" -t "$IMAGE_NAME:$CI_COMMIT_TAG" -t "$IMAGE_NAME:stable" .
    - docker push "$IMAGE_NAME:$CI_COMMIT_SHORT_SHA"
    - docker push "$IMAGE_NAME:$CI_COMMIT_TAG"
    - docker push "$IMAGE_NAME:stable"
